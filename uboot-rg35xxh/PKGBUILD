pkgname=uboot-rg35xxh
pkgver=v2025.01
_pkgver=v2025.01
pkgrel=3
_tfaver=2.12.0
pkgdesc="U-Boot for rg35xxh"
arch=('aarch64')
url='http://www.denx.de/wiki/U-Boot/WebHome'
license=('GPL')
makedepends=('bc' 'python' 'python-setuptools' 'swig' 'dtc' 'bison' 'flex')
provides=('uboot')
conflicts=('uboot')
replaces=('uboot-rg35xxh')
install=${pkgname}.install
source=("https://source.denx.de/u-boot/u-boot/-/archive/${_pkgver}/u-boot-${_pkgver}.tar.gz"
        "https://github.com/ARM-software/arm-trusted-firmware/archive/refs/tags/v${_tfaver}.tar.gz"
        "0001.patch"
        "0004.patch"
        "0005-sunxi-H616- dram-Improve-size-scan-procedure.patch"
        #"0006.patch"
        #"0007.patch"
        #"0008.patch"
        #"0009.patch"
        )
sha256sums=('SKIP'
            'SKIP'
