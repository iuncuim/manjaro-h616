---
 arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi            | 1 +
 arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts   | 4 ++++
 arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts | 4 ++++
 arch/arm64/boot/dts/allwinner/sun55i-t527-walnutpi-2b.dts | 4 ++++
 4 files changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index edf262960..9bc2d9b44 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -922,6 +922,7 @@ npu: npu@7122000 {
 			clock-names = "bus", "core", "reg";
 			resets = <&mcu_ccu RST_BUS_MCU_NPU>;
 			power-domains = <&ppu PD_NPU>;
+			status = "disabled";
 		};
 
 		ccu_cpu: clock@8817000 {
diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
