+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-avaota-a1.dts
@@ -154,6 +154,10 @@ &mmc2 {
 	status = "okay";
 };
 
+&npu {
+	status = "okay";
+};
+
 &ohci0 {
 	status = "okay";
 };
