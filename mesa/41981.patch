From 8f8a54cc58be9ee0db67145eba643c02a42cde12 Mon Sep 17 00:00:00 2001
From: Ryan Mckeever <ryan.mckeever@collabora.com>
Date: Tue, 23 Jun 2026 22:31:47 -0700
Subject: [PATCH 2/3] pan/bi: set branch reconvergence at loop exit points

A clause requires reconvergence if it has a successor that can be executed
without first executing the clause itself. Separate iterations of a loop
are treated separately here. So when the loop iteration count is not
warp-invariant, we also need branch reconvergence at loop exit points.

This commit is setting reconvergence for all such locations, so we could
do better by checking for a warp-invariant iteration count.
---
 .../compiler/bifrost/bifrost/bi_schedule.c    |  2 +-
 .../compiler/bifrost/bifrost_compile.c        | 32 +++++++++++++------
 src/panfrost/compiler/bifrost/compiler.h      |  3 ++
 3 files changed, 26 insertions(+), 11 deletions(-)

diff --git a/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c b/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c
index c655956afae..6349a1de8cf 100644
--- a/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c
+++ b/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c
@@ -2017,7 +2017,7 @@ bi_schedule_block(bi_context *ctx, bi_block *block)
    if (!list_is_empty(&block->clauses)) {
       bi_clause *last_clause =
          list_last_entry(&block->clauses, bi_clause, link);
-      if (bi_reconverge_branches(block))
+      if (bi_reconverge_branches(block) || block->needs_reconvergence_on_exit)
          last_clause->flow_control = BIFROST_FLOW_NBTB_UNCONDITIONAL;
    }
 
diff --git a/src/panfrost/compiler/bifrost/bifrost_compile.c b/src/panfrost/compiler/bifrost/bifrost_compile.c
index 091dced0517..226dabb308f 100644
--- a/src/panfrost/compiler/bifrost/bifrost_compile.c
+++ b/src/panfrost/compiler/bifrost/bifrost_compile.c
@@ -30,7 +30,8 @@ static void pan_stats_verbose(FILE *f, const char *prefix, bi_context *ctx,
  * clause of the shader, this range must be valid instructions or zero. */
 #define BIFROST_SHADER_PREFETCH 128
 
-static bi_block *emit_cf_list(bi_context *ctx, struct exec_list *list);
+static bi_block *emit_cf_list(bi_context *ctx, struct exec_list *list,
+                              bool loop_body);
 
 static bi_index
 bi_preload(bi_builder *b, enum bi_preload val)
@@ -3671,7 +3672,7 @@ create_empty_block(bi_context *ctx)
 }
 
 static bi_block *
-emit_block(bi_context *ctx, nir_block *block)
+emit_block(bi_context *ctx, nir_block *block, bool loop_body)
 {
    if (ctx->after_block) {
       ctx->current_block = ctx->after_block;
@@ -3692,11 +3693,15 @@ emit_block(bi_context *ctx, nir_block *block)
       bi_emit_instr(&_b, instr);
    }
 
+   /* We need branch reconvergence in the break block of a loop. */
+   ctx->current_block->needs_reconvergence_on_exit =
+      loop_body && nir_block_ends_in_break(block);
+
    return ctx->current_block;
 }
 
 static void
-emit_if(bi_context *ctx, nir_if *nif)
+emit_if(bi_context *ctx, nir_if *nif, bool loop_body)
 {
    bi_block *before_block = ctx->current_block;
 
@@ -3707,15 +3712,21 @@ emit_if(bi_context *ctx, nir_if *nif)
                      bi_zero(), BI_CMPF_EQ);
 
    /* Emit the two subblocks. */
-   bi_block *then_block = emit_cf_list(ctx, &nif->then_list);
+   bi_block *then_block = emit_cf_list(ctx, &nif->then_list, loop_body);
    bi_block *end_then_block = ctx->current_block;
 
    /* Emit second block */
 
-   bi_block *else_block = emit_cf_list(ctx, &nif->else_list);
+   bi_block *else_block = emit_cf_list(ctx, &nif->else_list, loop_body);
    bi_block *end_else_block = ctx->current_block;
    ctx->after_block = create_empty_block(ctx);
 
+   /* TODO: determine why this is needed */
+   if (then_block->needs_reconvergence_on_exit)
+      else_block->needs_reconvergence_on_exit = true;
+   else if (else_block->needs_reconvergence_on_exit)
+      then_block->needs_reconvergence_on_exit = true;
+
    /* Now that we have the subblocks emitted, fix up the branches */
 
    assert(then_block);
@@ -3753,7 +3764,7 @@ emit_loop(bi_context *ctx, nir_loop *nloop)
    ctx->after_block->loop_header = true;
 
    /* Emit the body itself */
-   emit_cf_list(ctx, &nloop->body);
+   emit_cf_list(ctx, &nloop->body, true);
 
    /* Branch back to loop back */
    bi_builder _b = bi_init_builder(ctx, bi_after_block(ctx->current_block));
@@ -3771,14 +3782,15 @@ emit_loop(bi_context *ctx, nir_loop *nloop)
 }
 
 static bi_block *
-emit_cf_list(bi_context *ctx, struct exec_list *list)
+emit_cf_list(bi_context *ctx, struct exec_list *list, bool loop_body)
 {
    bi_block *start_block = NULL;
 
    foreach_list_typed(nir_cf_node, node, node, list) {
       switch (node->type) {
       case nir_cf_node_block: {
-         bi_block *block = emit_block(ctx, nir_cf_node_as_block(node));
+         bi_block *block = emit_block(ctx, nir_cf_node_as_block(node),
+                                      loop_body);
 
          if (!start_block)
             start_block = block;
@@ -3787,7 +3799,7 @@ emit_cf_list(bi_context *ctx, struct exec_list *list)
       }
 
       case nir_cf_node_if:
-         emit_if(ctx, nir_cf_node_as_if(node));
+         emit_if(ctx, nir_cf_node_as_if(node), loop_body);
          break;
 
       case nir_cf_node_loop:
@@ -4309,7 +4321,7 @@ bi_compile_variant_nir(nir_shader *nir,
 
       ctx->ssa_alloc += impl->ssa_alloc;
 
-      emit_cf_list(ctx, &impl->body);
+      emit_cf_list(ctx, &impl->body, false);
       bi_emit_phis_deferred(ctx);
       break; /* TODO: Multi-function shaders */
    }
diff --git a/src/panfrost/compiler/bifrost/compiler.h b/src/panfrost/compiler/bifrost/compiler.h
index 39b4f8d09a0..7f3c3de3a06 100644
--- a/src/panfrost/compiler/bifrost/compiler.h
+++ b/src/panfrost/compiler/bifrost/compiler.h
@@ -970,6 +970,9 @@ typedef struct bi_block {
    bool unconditional_jumps;
    bool loop_header;
 
+   /* whether this is a loop exit point that needs branch reconvergence */
+   bool needs_reconvergence_on_exit;
+
    /* Per 32-bit word live masks for the block indexed by node */
    uint8_t *live_in;
    uint8_t *live_out;
-- 
2.55.0


